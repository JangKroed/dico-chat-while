{
  "manifest_version": 3,
  "name": "DICO 중앙관리 실행기",
  "version": "0.4.66",
  "key": "",
  "description": "이 PC의 DICO 관리 프로그램과 연결해 지정한 계정·채널의 공지를 실행합니다.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "nativeMessaging",
    "notifications",
    "sidePanel",
    "tabGroups",
    "webRequest"
  ],
  "host_permissions": [
    "https://discord.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DICO 중앙관리",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/channels/*"
      ],
      "js": [
        "emoji-data.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
